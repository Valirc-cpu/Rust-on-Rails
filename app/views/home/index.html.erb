</header>

<main class="railst-container">
  <!-- Hero Section (hero-band per DESIGN.md) -->
  <section class="hero-band">
    <div class="badge-coral">
      In-Process C-ABI // Global VM Lock Bypass
    </div>

    <h1 class="hero-headline">
      The Velocity of Rails.<br>
      The Pure Power of <em>Rust</em>.
    </h1>

    <p class="hero-body">
      An editorial, in-process computing framework pairing the rapid ergonomics of Ruby on Rails 8 with native multi-core Rust acceleration through Magnus 0.9 and Rayon.
    </p>

    <div class="hero-actions">
      <a href="#benchmark" class="button-primary">
        Run In-Process Benchmark
      </a>
      <a href="#commands" class="button-secondary">
        Explore railst CLI
      </a>
    </div>
  </section>

  <!-- Interactive Product Mockup / Code Window (code-window-card per DESIGN.md) -->
  <section id="benchmark" class="code-window-card">
    <div class="code-window-header">
      <div class="window-dots">
        <div class="window-dot"></div>
        <div class="window-dot"></div>
        <div class="window-dot"></div>
      </div>
      <div class="window-title">ext/rust_backend/src/data_processor.rs</div>
      <div style="font-family: var(--font-code); font-size: 11px; color: var(--colors-on-dark-soft);">
        Magnus 0.9 + Rayon (<%= @cpu_cores %> Cores)
      </div>
    </div>

    <div class="code-window-body">
      <div class="benchmark-layout">
        <!-- Code Window Display -->
        <div class="benchmark-code-pane">
          <div><span class="code-comment">// High-performance parallel reduction with GVL released</span></div>
          <div><span class="code-keyword">pub fn</span> <span class="code-fn">aggregate_metrics</span>(items: &amp;[<span class="code-type">Record</span>]) -&gt; <span class="code-type">Metrics</span> {</div>
          <div>&nbsp;&nbsp;items.<span class="code-fn">par_iter</span>()</div>
          <div>&nbsp;&nbsp;&nbsp;&nbsp;.<span class="code-fn">fold</span>(|| <span class="code-type">Acc</span>::default(), |<span class="code-keyword">mut</span> acc, r| {</div>
          <div>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;acc.sum += r.val;</div>
          <div>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;acc.count += <span class="code-type">1</span>;</div>
          <div>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;acc</div>
          <div>&nbsp;&nbsp;&nbsp;&nbsp;})</div>
          <div>&nbsp;&nbsp;&nbsp;&nbsp;.<span class="code-fn">reduce</span>(|| <span class="code-type">Acc</span>::default(), |a, b| a + b)</div>
          <div>}</div>
        </div>

        <!-- Interactive Control Panel -->
        <div class="benchmark-control-pane">
          <div>
            <h3 class="control-title">In-Memory Latency Test</h3>
            <p class="control-desc">
              Measures live C-ABI data exchange latency from Ruby to the native Rayon multi-threaded engine without HTTP serialization overhead.
            </p>

            <label for="benchmark-count" class="result-label">Dataset Scale</label>
            <select id="benchmark-count" class="control-select">
              <option value="10000">10,000 Records</option>
              <option value="50000" selected>50,000 Records</option>
              <option value="100000">100,000 Records</option>
            </select>

            <button id="btn-run-benchmark" class="button-primary" style="width: 100%;">
              Execute Benchmark
            </button>
          </div>

          <div class="results-grid">
            <div class="result-card">
              <div class="result-label">Latency</div>
              <div id="metric-latency" class="result-value">0.28 ms</div>
            </div>
            <div class="result-card">
              <div class="result-label">Processed</div>
              <div id="metric-records" class="result-value ruby">50,000</div>
            </div>
            <div class="result-card">
              <div class="result-label">Throughput</div>
              <div id="metric-throughput" class="result-value">~178k/s</div>
            </div>
            <div class="result-card">
              <div class="result-label">Engine Mode</div>
              <div class="result-value green">Non-GVL</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Editorial Feature Grid (feature-card per DESIGN.md) -->
  <section style="margin-bottom: var(--spacing-section);">
    <div class="feature-section-header">
      <div class="section-label">Core Architecture</div>
      <h2 class="section-title">Engineered for Compute-Heavy Workloads</h2>
    </div>

    <div class="features-grid">
      <div class="feature-card">
        <div>
          <div class="card-glyph">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
              <rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
              <line x1="6" y1="6" x2="6.01" y2="6"></line>
              <line x1="6" y1="18" x2="6.01" y2="18"></line>
            </svg>
          </div>
          <h3 class="card-title">In-Process C-ABI Bridge</h3>
          <p class="card-body">
            Direct memory communication via Magnus 0.9 without socket serialization or network overhead. Ruby hashes and arrays seamlessly convert to native Rust data types.
          </p>
        </div>
        <div class="card-meta">
          lib/rust_backend/rust_backend.so
        </div>
      </div>

      <div class="feature-card">
        <div>
          <div class="card-glyph" style="color: var(--colors-ruby);">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
          </div>
          <h3 class="card-title">Global VM Lock Bypass</h3>
          <p class="card-body">
            Releases the Ruby VM Lock (<code style="font-family: var(--font-code); font-size: 13px; color: var(--colors-primary);">rb_thread_call_without_gvl</code>) during heavy calculations, allowing Rayon parallel iterators to utilize every CPU core.
          </p>
        </div>
        <div class="card-meta">
          ext/rust_backend/src/gvl.rs
        </div>
      </div>

      <div class="feature-card">
        <div>
          <div class="card-glyph">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
              <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
              <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
            </svg>
          </div>
          <h3 class="card-title">ActiveRecord Integration</h3>
          <p class="card-body">
            Maintains 100% Rails ORM conventions. Models include the <code style="font-family: var(--font-code); font-size: 13px; color: var(--colors-primary);">RustBacked</code> concern to access batch processing and aggregate reduction without writing C bindings.
          </p>
        </div>
        <div class="card-meta">
          app/models/concerns/rust_backed.rb
        </div>
      </div>
    </div>
  </section>

  <!-- CLI Marquee Band (cta-band-dark per DESIGN.md) -->
