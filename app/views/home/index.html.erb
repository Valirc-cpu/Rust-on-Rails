<script>
  document.addEventListener("DOMContentLoaded", () => {
    const btn = document.getElementById("btn-run-benchmark");
    const select = document.getElementById("benchmark-count");
    const latencyEl = document.getElementById("metric-latency");
    const recordsEl = document.getElementById("metric-records");
    const throughputEl = document.getElementById("metric-throughput");

    if (btn && select) {
      btn.addEventListener("click", async () => {
        const count = parseInt(select.value, 10);
        btn.disabled = true;
        btn.textContent = "Computing...";

        try {
          const res = await fetch("/benchmark", {
            method: "POST",
            headers: {
              "Content-Type": "application/json"
            },
            body: JSON.stringify({ count: count })
          });

          const data = await res.json();
          if (data.status === "ok") {
            latencyEl.textContent = `${data.duration_ms} ms`;
            recordsEl.textContent = Number(data.records).toLocaleString();

            const throughput = Math.round((data.records / (data.duration_ms / 1000)));
            throughputEl.textContent = `~${Number(throughput).toLocaleString()}/s`;
          } else {
            latencyEl.textContent = "Error";
          }
        } catch (err) {
          latencyEl.textContent = "Failed";
          console.error(err);
        } finally {
          btn.disabled = false;
          btn.textContent = "Execute Benchmark";
        }
      });
    }
  });
</script>
