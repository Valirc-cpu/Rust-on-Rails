<div class="railst-container">
  <!-- Navigation Header -->
  <header class="railst-nav">
    <a href="/" class="nav-brand">
      <div class="brand-icon-box">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <!-- Combined Gear & Gem Emblem -->
          <circle cx="12" cy="12" r="3"></circle>
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
        </svg>
      </div>
      <div>
        <span class="brand-name">Railst</span>
        <span class="brand-badge">Engine</span>
      </div>
    </a>

    <div class="nav-badges">
      <span class="status-pill">
        <span class="dot-pulse"></span>
        Rust Backend: Active
      </span>
      <span class="status-pill">
        Rails <%= @rails_version %>
      </span>
      <span class="status-pill">
        Ruby <%= RUBY_VERSION %>
      </span>
      <a href="/up" target="_blank" class="status-pill" title="Health Check Status">
        Health: 200 OK
      </a>
    </div>
  </header>

  <!-- Hero Section -->
  <main>
    <section class="railst-hero">
      <div class="hero-tag">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
        In-Process C-ABI // Global VM Lock Bypass
      </div>

      <h1 class="hero-title">
        <span class="gradient-rust">The Velocity of Rails.</span><br>
        <span class="gradient-ruby">The Pure Power of Rust.</span>
      </h1>

      <p class="hero-desc">
        A high-performance computing framework combining the developer ergonomics of Ruby on Rails 8 with an in-process native Rust backend powered by Magnus 0.9 and Rayon multi-threading.
      </p>

      <div class="hero-actions">
        <a href="#benchmark" class="btn-primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
          Run In-Process Benchmark
        </a>
        <a href="#cli" class="btn-secondary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="4 17 10 11 4 5"></polyline>
            <line x1="12" y1="19" x2="20" y2="19"></line>
          </svg>
          Explore Railst CLI
        </a>
      </div>
    </section>

    <!-- Interactive Live Benchmark Section -->
    <section id="benchmark" class="benchmark-section">
      <div class="benchmark-header">
        <div class="benchmark-title-wrap">
          <div class="brand-icon-box" style="width: 32px; height: 32px; border-radius: 8px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
          </div>
          <div>
            <h2 class="benchmark-title">Live In-Process Rust Benchmark</h2>
            <p class="benchmark-subtitle">Tests Ruby-to-Rust C-ABI data passing, Rayon parallel reduction, and GVL bypass latency.</p>
          </div>
        </div>

        <div class="benchmark-controls">
          <select id="benchmark-count" class="benchmark-select">
            <option value="10000">10,000 Records</option>
            <option value="50000" selected>50,000 Records</option>
            <option value="100000">100,000 Records</option>
          </select>
          <button id="btn-run-benchmark" class="btn-primary" style="padding: 8px 18px; font-size: 0.88rem;">
            Run Benchmark
          </button>
        </div>
      </div>

      <div class="benchmark-output-grid">
        <div class="metric-tile">
          <div class="metric-label">Execution Latency</div>
          <div id="metric-latency" class="metric-value highlight-rust">0.24 ms</div>
          <div class="metric-sub">Pure in-memory FFI bridge</div>
        </div>

        <div class="metric-tile">
          <div class="metric-label">Records Processed</div>
          <div id="metric-records" class="metric-value">50,000</div>
          <div class="metric-sub">Rayon parallel reduction</div>
        </div>

        <div class="metric-tile">
          <div class="metric-label">Throughput Rate</div>
          <div id="metric-throughput" class="metric-value highlight-ruby">~208,300/s</div>
          <div class="metric-sub">Multi-threaded crunching</div>
        </div>

        <div class="metric-tile">
          <div class="metric-label">Threading Mode</div>
          <div id="metric-threads" class="metric-value highlight-green">Non-GVL</div>
          <div class="metric-sub"><%= @cpu_cores %> Cores Active</div>
        </div>
      </div>
    </section>

    <!-- Architecture Features Grid -->
    <section class="features-grid">
      <div class="feature-card">
        <div class="card-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="3"></circle>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
          </svg>
        </div>
        <h3 class="card-title">Magnus 0.9 C-ABI Bridge</h3>
        <p class="card-desc">Direct in-process communication between Ruby and Rust without network sockets, serialization bottlenecks, or HTTP middleware overhead.</p>
      </div>

      <div class="feature-card">
        <div class="card-icon" style="color: var(--ruby-light);">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
          </svg>
        </div>
        <h3 class="card-title">Automatic GVL Bypass</h3>
        <p class="card-desc">Safely releases the Ruby VM Lock (<code style="color: var(--rust-light);">rb_thread_call_without_gvl</code>) during computation, enabling full Rayon parallel execution across all CPU cores.</p>
      </div>

      <div class="feature-card">
        <div class="card-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
            <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
            <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
          </svg>
        </div>
        <h3 class="card-title">ActiveRecord Integration</h3>
        <p class="card-desc">Preserves standard Rails migrations and models via the <code style="color: var(--rust-light);">RustBacked</code> concern, providing native <code style="color: var(--ruby-light);">rust_batch_process</code> and <code style="color: var(--ruby-light);">rust_aggregate</code>.</p>
      </div>

      <div class="feature-card">
        <div class="card-icon" style="color: var(--ruby-light);">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
            <line x1="8" y1="21" x2="16" y2="21"></line>
            <line x1="12" y1="17" x2="12" y2="21"></line>
          </svg>
        </div>
        <h3 class="card-title">Laravel-Style Terminal CLI</h3>
        <p class="card-desc">Elegant developer interface via <code style="color: var(--rust-light);">railst run</code> with graceful port collision detection, live request trackers, and zero emoji clutter.</p>
      </div>
    </section>

    <!-- Quickstart Command Section -->
    <section id="cli" class="terminal-section">
      <div class="terminal-header">
        <div class="terminal-dots">
          <div class="terminal-dot"></div>
          <div class="terminal-dot"></div>
          <div class="terminal-dot"></div>
        </div>
        <div class="terminal-title">railst CLI Quickstart</div>
        <div></div>
      </div>
      <div class="terminal-body">
        <div class="terminal-line">
          <span class="terminal-prompt">$</span>
          <span class="terminal-cmd">railst run -p 3001</span>
          <span class="terminal-comment"># Start Rails development server with auto-build</span>
        </div>
        <div class="terminal-line">
          <span class="terminal-prompt">$</span>
          <span class="terminal-cmd">railst run --find-port</span>
          <span class="terminal-comment"># Automatically select next free port if 3000 is occupied</span>
        </div>
        <div class="terminal-line">
          <span class="terminal-prompt">$</span>
          <span class="terminal-cmd">railst g rust:resource Metric device_id:string value:float</span>
          <span class="terminal-comment"># Scaffold Rust-backed model, migration, and controller</span>
        </div>
        <div class="terminal-line">
          <span class="terminal-prompt">$</span>
          <span class="terminal-cmd">railst test</span>
          <span class="terminal-comment"># Run native Rust unit tests and Rails test suite</span>
        </div>
        <div class="terminal-line">
          <span class="terminal-prompt">$</span>
          <span class="terminal-cmd">railst ci</span>
          <span class="terminal-comment"># Execute full 7-step Continuous Integration suite</span>
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="railst-footer">
    <p>Railst Framework &middot; Combining Ruby on Rails 8 and pure Rust Magnus 0.9 &middot; MIT License</p>
  </footer>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const btn = document.getElementById("btn-run-benchmark");
    const select = document.getElementById("benchmark-count");
    const latencyEl = document.getElementById("metric-latency");
    const recordsEl = document.getElementById("metric-records");
    const throughputEl = document.getElementById("metric-throughput");
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute("content");

    if (btn) {
      btn.addEventListener("click", async () => {
        const count = parseInt(select.value, 10);
        btn.disabled = true;
        btn.textContent = "Processing...";

        try {
          const res = await fetch("/benchmark", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "X-CSRF-Token": csrfToken || ""
            },
            body: JSON.stringify({ count: count })
          });

          const data = await res.json();
          if (data.status === "ok") {
            latencyEl.textContent = `${data.duration_ms} ms`;
            recordsEl.textContent = Number(data.records).toLocaleString();

            const throughput = Math.round((data.records / (data.duration_ms / 1000)));
            throughputEl.textContent = `~${Number(throughput).toLocaleString()}/s`;
          } else {
            latencyEl.textContent = "Error";
          }
        } catch (err) {
          latencyEl.textContent = "Failed";
          console.error(err);
        } finally {
          btn.disabled = false;
          btn.textContent = "Run Benchmark";
        }
      });
    }
  });
</script>
