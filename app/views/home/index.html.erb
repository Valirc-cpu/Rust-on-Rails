      <h2 class="cli-band-title">Designed for Modern Developer Velocity</h2>
      <p class="cli-band-desc">
        The built-in <code style="font-family: var(--font-code); color: var(--colors-primary);">railst</code> CLI utility provides a clean developer interface inspired by Laravel, complete with automated port collision handling, real-time request tracking, and zero emoji clutter.
      </p>
      <a href="/up" target="_blank" class="button-secondary-on-dark">
        Check System Health (/up)
      </a>
    </div>

    <div class="terminal-box">
      <div class="term-line">
        <span class="term-prompt">$</span>
        <span class="term-cmd">railst run -p 3001</span>
        <span class="term-comment"># Start development server</span>
      </div>
      <div class="term-line">
        <span class="term-prompt">$</span>
        <span class="term-cmd">railst run --find-port</span>
        <span class="term-comment"># Auto-select next free port</span>
      </div>
      <div class="term-line">
        <span class="term-prompt">$</span>
        <span class="term-cmd">railst g rust:resource Invoice amount:decimal</span>
      </div>
      <div class="term-line">
        <span class="term-prompt">$</span>
        <span class="term-cmd">railst test</span>
        <span class="term-comment"># Run Rust unit tests and Rails suite</span>
      </div>
      <div class="term-line">
        <span class="term-prompt">$</span>
        <span class="term-cmd">railst ci</span>
        <span class="term-comment"># Full 7-step CI pipeline</span>
      </div>
    </div>
  </section>
</main>

